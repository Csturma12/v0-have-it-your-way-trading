From c8bc99886210c332bb5b63bea2bcd52a2b74d249 Mon Sep 17 00:00:00 2001
From: v0 <v0[bot]@users.noreply.github.com>
Date: Fri, 1 May 2026 16:34:34 +0000
Subject: [PATCH 02/19] chore: gitignore auto-regenerated next-env.d.ts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Next.js regenerates next-env.d.ts on every build/dev cycle and the
import path inside it flips between '.next/types/...' (production
build) and '.next/dev/types/...' (dev server), so the file never
stays clean in git. Per Next.js docs the file should not be hand
edited — adding it to .gitignore and removing the tracked copy so
it stops showing up as modified after every dev run.

Co-authored-by: v0[bot] <v0[bot]@users.noreply.github.com>
---
 .gitignore    | 5 +++++
 next-env.d.ts | 6 ------
 2 files changed, 5 insertions(+), 6 deletions(-)
 delete mode 100644 next-env.d.ts

diff --git a/.gitignore b/.gitignore
index 0e2a676..ca9799e 100644
--- a/.gitignore
+++ b/.gitignore
@@ -13,3 +13,8 @@ __v0_jsx-dev-runtime.ts
 node_modules
 .next/
 .DS_Store
+
+# Auto-generated by Next.js on every build/dev cycle. Path inside it
+# flips between `.next/types/...` and `.next/dev/types/...` so it
+# never stays clean in git. Safe to ignore — Next regenerates it.
+next-env.d.ts
diff --git a/next-env.d.ts b/next-env.d.ts
deleted file mode 100644
index 9edff1c..0000000
--- a/next-env.d.ts
+++ /dev/null
@@ -1,6 +0,0 @@
-/// <reference types="next" />
-/// <reference types="next/image-types/global" />
-import "./.next/types/routes.d.ts";
-
-// NOTE: This file should not be edited
-// see https://nextjs.org/docs/app/api-reference/config/typescript for more information.
-- 
2.49.0


